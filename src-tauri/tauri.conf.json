{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pip-chan",
  "version": "0.1.0",
  "identifier": "com.pipchan.overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Pip-chan",
        "width": 340,
        "height": 530,
        "minWidth": 340,
        "minHeight": 530,
        "maxWidth": 340,
        "maxHeight": 530,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": { "minimumSystemVersion": "11.0" }
  }
}
